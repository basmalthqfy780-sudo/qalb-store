# ── Qalb storefront ───────────────────────────────────────────────
# بدون أي قيمة يعمل المتجر في وضع local: الطلبات والمفاتيح تُخزَّن في
# localStorage فقط (مناسب للعرض والتجربة).

# local | rest
VITE_QALB_API=local

# عنوان خدمة الطلبات عند تحويل الوضع إلى rest
VITE_QALB_API_BASE=http://localhost:8787
# اتركه فارغًا (VITE_QALB_API_BASE=) مع npm run dev: يفوّت Vite مسارات
# /orders و/admin و/catalog و/health إلى :8787 من نفس الأصل، فلا نداء إلى
# localhost من المتصفح — مفيد حين يكون منفذ المعاينة واحدًا.

# البريد الرسمي للموقع: يظهر في الواجهات وفي ملفات الإيصال وJSON-LD.
# غيّره هنا مؤقتًا لبريد بديل؛ تركه فارغًا يُبقي الافتراضي qalb@qalb.store.
VITE_QALB_MAIL=qalb@qalb.store

# ── النشر (scripts/seo.mjs و server/worker.js يقرآن .env نفسَه) ─────
# النطاق النهائي: يدخل في robots.txt و sitemap.xml و og:url/canonical والبطاقات.
# يقرأهما node يدويًا (لا Vite)، فقيم واحدة تكفي لكل أمر.
# اتركه فارغًا للتجربة المحلية (يبقى https://qalb.store كما هو).
SITE_URL=

# ── هويةُ الجهة البائعة في ورقةِ عرضِ السعر (src/data/company.js) ──────
# ورقةُ «عرضُ سعر» في /b2b تُطبع وفيها السجلُّ التجاريُّ والرقمُ الضريبيُّ وIBAN.
# ما يبقى فارغًا هنا يُطبع «قيدَ التوثيق» مع قائمةِ الناقص — لا يُختلَق رقمٌ أبدًا.
VITE_QALB_LEGAL_NAME=
VITE_QALB_LEGAL_CR=
VITE_QALB_LEGAL_VAT=
VITE_QALB_LEGAL_IBAN=
VITE_QALB_LEGAL_BANK=
VITE_QALB_LEGAL_ADDRESS=

# هاتفُ المبيعات ورابطُ حجز عرضٍ قصير (٢٠ دقيقة). لا قيمة؟ لا زرَّ «اتصل» في
# الصفحة ولا موعدًا مُوهَمًا — تُطبع الجملةُ التي تقول إننا لا نستقبل مكالمات بعد.
VITE_QALB_PHONE=
VITE_QALB_BOOKING=
# رقمُ المنشأة في منصة اعتماد متى نُشرنا هناك؛ فارغٌ = الصفحةُ تقول «لسنا مُدرجةً بعد».
VITE_QALB_ETIMAD=

# ── دفاترُ الخادم (server/leads.js و server/orgs.js) ──────────────────
# off تُطفئ طبقةَ دفترِ طلبات الجهات كلها (فيعود الطلبُ إلى متصفح صاحبه).
QALB_LEADS=
# off يُطفئ بوابةَ الاستبدال المؤسسي (POST /org/redeem).
QALB_B2B=

# ── لوحة الإدارة (server/admin.js) ────────────────────────────────
# أول تشغيل مع ADMIN_PASSWORD ينشئ حساب المالك في server/admins.json.
# احذف الملف ثم أطفئ/أشغّل لإعادة التهيئة. كلمة السر ١٠ أحرف على الأقل.
ADMIN_PASSWORD=
ADMIN_EMAIL=qalb@qalb.store
ADMIN_NAME=Qalb Owner
# النطاق المسموح له بتغيير البيانات عبر كوكيز اللوحة (فحص CSRF).
# اتركه فارغًا في التطوير، واضبطه على نطاق موقعك في الإنتاج.
ADMIN_ORIGIN=
# على جهاز جديد فقط: اسمح بإنشاء أول حساب من لوحة الإدارة نفسها، ثم عطّله
#ALLOW_ADMIN_SETUP=1

# ── داخل server/ فقط (وليس في الحزمة العامة) ──────────────────────
# Supabase/Postgres — إن لم تُضبط يكتب server/worker.js في orders.jsonl
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PORT=8787
# مجلد بيانات اللوحة والطلبات (مجلد مخزون قابل للكتابة على السحابة).
# فارغ = مجلد server/ نفسه؛ وnpm run test:api يعمل في مجلد مؤقت
# لا يمسّ بياناتك.
QALB_DATA_DIR=

# ── تسليم الملفات (server/deliver.js) ────────────────────────────────
# مدة صلاحية رابط التنزيل الموقّع بالثواني (60–86400، الافتراضي 600).
DOWNLOAD_TTL=600
# أقصى ما يمنحه الخادم لعنوان IP واحد داخل تلك المدة (كل تنزيل = طلبان: رابط ثم استهلاكه).
DOWNLOAD_MAX=24
# مفتاح توقيع الروابط؛ اتركه فارغًا ليُنشأ server/.download-secret (0600) تلقائيًا.
DOWNLOAD_SECRET=
